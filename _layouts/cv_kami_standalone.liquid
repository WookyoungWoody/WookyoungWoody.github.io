<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ site.data.resume.basics.name }}
      · CV
    </title>
    <meta name="author" content="{{ site.data.resume.basics.name }}">
    <meta name="description" content="{{ page.description | default: site.description | strip_newlines }}">
    <meta name="generator" content="Jekyll + Kami (tw93/Kami) design system">
    <link rel="icon" href="{{ '/assets/img/favicon.ico' | relative_url }}" type="image/x-icon">
  </head>
  <body style="background: #f5f4ed; margin: 0; padding: 0">
    {% include cv_kami_body.liquid %}
  </body>
</html>

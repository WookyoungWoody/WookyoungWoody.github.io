{%- comment -%} Home page block: current projects. Renders nothing when there are none. {%- endcomment -%}
{%- capture pp_order -%}{% include projects/order.liquid mode="current" %}{%- endcapture -%}
{%- assign pp_n = pp_order | strip | split: ',' | size -%}
{%- if pp_n > 0 -%}
  <section id="current-projects-home" class="project-portfolio pp-home">
    <h2><a href="{{ '/projects/' | relative_url }}" style="color: inherit">current projects</a></h2>
    {% include projects/list.liquid mode="current" compact="true" %}
    <p class="pp-footer"><a href="{{ '/projects/' | relative_url }}">All projects, roles, and research areas</a></p>
  </section>
{%- endif -%}

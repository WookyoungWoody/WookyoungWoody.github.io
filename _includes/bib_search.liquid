{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  {% comment %}Keep the input on one line: kramdown escapes a multi-line inline tag when this include renders inside Markdown.{% endcomment %}
  <!-- prettier-ignore -->
  <input type="text" id="bibsearch" aria-label="Search publications" spellcheck="false" autocomplete="off" class="search bibsearch-form-input" placeholder="Type to filter">
{% endif %}
